---
import DashboardCta from "./DashboardCta.astro";
interface Sample { id: string; label: string; file: string; code: string; note: string }
interface Props { title: string; description: string; source: string; samples: Sample[] }
const { title, description, source, samples } = Astro.props;
---
<section class="sdk" data-sdk><div class="sdk-copy"><p class="eyebrow">Official client packages</p><h2>{title}</h2><p>{description}</p><div class="sdk-actions"><DashboardCta /><a class="matrix-link" href={source} target="_blank" rel="noreferrer">Browse the complete client matrix ↗</a></div></div><div class="workbench"><div class="toolbar"><label><span>Language</span><select data-language aria-label="Select client language">{samples.map((sample,index)=><option value={sample.id} selected={index===0}>{sample.label}</option>)}</select></label><span class="filename" data-filename>{samples[0].file}</span><button type="button" data-copy>Copy</button></div>{samples.map((sample,index)=><article data-sample={sample.id} data-file={sample.file} hidden={index!==0}><pre tabindex="0"><code>{sample.code}</code></pre><p>{sample.note}</p></article>)}</div></section>
<script is:inline>document.querySelectorAll('[data-sdk]').forEach((root)=>{const select=root.querySelector('[data-language]');const filename=root.querySelector('[data-filename]');const copy=root.querySelector('[data-copy]');const panels=[...root.querySelectorAll('[data-sample]')];const show=(id)=>panels.forEach((panel)=>{const active=panel.dataset.sample===id;panel.hidden=!active;if(active)filename.textContent=panel.dataset.file||''});select?.addEventListener('change',(event)=>show(event.target.value));copy?.addEventListener('click',async()=>{const active=panels.find((panel)=>!panel.hidden);const code=active?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(code);copy.textContent='Copied'}catch{active?.querySelector('pre')?.focus();copy.textContent='Select code'}setTimeout(()=>copy.textContent='Copy',1200)})})</script>
<style>.sdk{display:grid;grid-template-columns:minmax(0,.8fr) minmax(30rem,1.2fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:clamp(5rem,11vw,10rem) 0}.sdk-copy h2{margin:.5rem 0 1rem;font-size:clamp(2.4rem,6vw,4.8rem);line-height:.94;letter-spacing:-.06em}.sdk-copy>p:not(.eyebrow){color:var(--muted);font-size:1.05rem}.sdk-actions{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-top:1.3rem}.sdk-actions>.matrix-link{font-weight:800;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff20;border-radius:1.3rem;background:#07101f;color:#dbeafe;box-shadow:0 32px 90px #07101f38}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#0d182b}.toolbar label{display:grid;gap:.28rem}.toolbar label span{color:#94a3b8;font:700 .62rem/1 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.6rem;background:#111e34;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{cursor:pointer;margin-left:auto}.filename{align-self:center;color:#94a3b8;font:600 .76rem/1 ui-monospace,monospace}.workbench pre{overflow:auto;min-height:22rem;max-height:30rem;margin:0;padding:1.25rem;font:500 .84rem/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.25rem 1rem;border-top:1px solid #ffffff15;color:#94a3b8;font-size:.8rem}@media(max-width:850px){.sdk{grid-template-columns:1fr}}@media(max-width:560px){.toolbar{align-items:stretch;flex-wrap:wrap}.filename{width:100%;order:3}.workbench pre{font-size:.76rem}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}</style>
