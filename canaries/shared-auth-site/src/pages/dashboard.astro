---
const candidate = import.meta.env.PUBLIC_DASHBOARD_URL?.trim();
let dashboardUrl: string | undefined;
if (candidate) {
  const parsed = new URL(candidate);
  if (parsed.protocol !== "https:" || parsed.username || parsed.password) {
    throw new Error("PUBLIC_DASHBOARD_URL must be an HTTPS URL without embedded credentials");
  }
  dashboardUrl = parsed.toString();
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Secure handoff to the Shared Auth organization directory dashboard." />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Shared Auth dashboard</title>
</head>
<body>
  <main>
    <a class="brand" href="/">← Shared Auth</a>
    <p class="eyebrow">Authenticated directory</p>
    <h1>Users, sessions, and roles—scoped to your organization.</h1>
    <p class="lede">The dashboard performs online token introspection, verifies the directory-read scope, and checks organization membership before returning any directory data.</p>
    {dashboardUrl ? (
      <a class="primary" href={dashboardUrl} rel="noreferrer" referrerpolicy="no-referrer">Continue to dashboard →</a>
    ) : (
      <section class="pending" aria-live="polite">
        <b>Dashboard endpoint pending</b>
        <span>Set the GitHub Pages variable <code>PUBLIC_DASHBOARD_URL</code> to the deployed HTTPS dashboard URL after the private server repository and route are provisioned.</span>
      </section>
    )}
    <div class="guardrails">
      <article><b>Organization isolation</b><span>No implicit cross-organization fallback.</span></article>
      <article><b>Session privacy</b><span>No raw bearer tokens, biometric templates, or unredacted secrets.</span></article>
      <article><b>Capability truth</b><span>Experimental and contract-only methods remain visibly fail-closed.</span></article>
    </div>
  </main>
</body>
</html>
<style>:root{--ink:#0b1020;--muted:#5f6b7c;--accent:#6d5dfc}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 80% 0,#6d5dfc26,transparent 34rem),linear-gradient(180deg,#eef2ff,#f8fafc);color:var(--ink);font:16px/1.6 Inter,ui-sans-serif,system-ui,sans-serif}main{width:min(860px,calc(100% - 2rem));padding:clamp(2rem,7vw,5rem);border:1px solid #0f172a14;border-radius:2rem;background:#ffffffd9;box-shadow:0 30px 100px #0f172a18}.brand{color:var(--ink);font-weight:850;text-decoration:none}.eyebrow{margin:3rem 0 .7rem;color:var(--accent);font:800 .72rem/1 ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase}h1{max-width:13ch;margin:0;font-size:clamp(2.8rem,7vw,5.4rem);line-height:.92;letter-spacing:-.065em}.lede{max-width:48rem;color:var(--muted);font-size:1.08rem}.primary{display:inline-block;margin-top:1.2rem;padding:.85rem 1.1rem;border-radius:.8rem;background:var(--ink);color:white;font-weight:850;text-decoration:none}.pending{display:grid;gap:.35rem;margin-top:1.5rem;padding:1rem 1.1rem;border:1px solid #f59e0b55;border-radius:.9rem;background:#fffbeb}.pending span{color:#7c5a16}.pending code{font-size:.84em}.guardrails{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-top:3rem}.guardrails article{display:grid;gap:.25rem;padding:1rem;border:1px solid #0f172a12;border-radius:.9rem;background:#f8fafc}.guardrails span{color:var(--muted);font-size:.82rem}@media(max-width:700px){.guardrails{grid-template-columns:1fr}}</style>
