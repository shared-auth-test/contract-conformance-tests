{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shared-auth-test/contract-conformance-tests/contracts/tjsv-peer-authority/authored.schema.json",
  "$defs": {
    "ExternalPeerContract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ExternalPeerContract",
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "enabled": { "type": "boolean" },
        "owner": { "type": "string" }
      },
      "required": ["repository", "enabled"],
      "unevaluatedProperties": false
    }
  }
}
